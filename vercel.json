{
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/change-history",
      "destination": "/changes",
      "permanent": true
    },
    {
      "source": "/raw/change-history.md",
      "destination": "/raw/changes.md",
      "permanent": true
    },
    {
      "source": "/getting-started/quickstart",
      "destination": "/client-integration",
      "permanent": true
    },
    {
      "source": "/getting-started/working-with-evaluations",
      "destination": "/client-integration",
      "permanent": true
    },
    {
      "source": "/tools/scaffold",
      "destination": "/client-integration",
      "permanent": true
    },
    {
      "source": "/tools/hyperboards",
      "destination": "/reference",
      "permanent": true
    },
    {
      "source": "/raw/getting-started/quickstart.md",
      "destination": "/raw/client-integration.md",
      "permanent": true
    },
    {
      "source": "/raw/getting-started/working-with-evaluations.md",
      "destination": "/raw/client-integration.md",
      "permanent": true
    },
    {
      "source": "/raw/tools/scaffold.md",
      "destination": "/raw/client-integration.md",
      "permanent": true
    },
    {
      "source": "/raw/tools/hyperboards.md",
      "destination": "/raw/reference.md",
      "permanent": true
    },
    {
      "source": "/architecture/epds",
      "destination": "https://github.com/hypercerts-org/ePDS/blob/main/docs/architecture.md",
      "permanent": true
    },
    {
      "source": "/raw/architecture/epds.md",
      "destination": "https://github.com/hypercerts-org/ePDS/blob/main/docs/architecture.md",
      "permanent": true
    },
    {
      "source": "/tutorials/epds",
      "destination": "https://github.com/hypercerts-org/ePDS/blob/main/docs/tutorial.md",
      "permanent": true
    },
    {
      "source": "/raw/tutorials/epds.md",
      "destination": "https://github.com/hypercerts-org/ePDS/blob/main/docs/tutorial.md",
      "permanent": true
    },
    {
      "source": "/tools/hyperindex",
      "destination": "https://github.com/GainForest/hyperindex/blob/main/docs/hyperindex.md",
      "permanent": true
    },
    {
      "source": "/raw/tools/hyperindex.md",
      "destination": "https://github.com/GainForest/hyperindex/blob/main/docs/hyperindex.md",
      "permanent": true
    }
  ]
}
