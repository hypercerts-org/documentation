      "permanent": true
    },
    {
      "source": "/raw/getting-started/working-with-evaluations.md",
      "destination": "/raw/client-integration.md",
      "permanent": true
    },
    {
      "source": "/raw/tools/scaffold.md",
      "destination": "/raw/client-integration.md",
      "permanent": true
    },
    {
      "source": "/raw/tools/hyperboards.md",
